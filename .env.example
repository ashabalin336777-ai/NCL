# Application
APP_NAME=NeuroCloser — NCL Sales Trainer
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres
POSTGRES_USER=ncl
POSTGRES_PASSWORD=ncl
POSTGRES_DB=ncl
DATABASE_URL=postgresql+asyncpg://ncl:ncl@postgres:5432/ncl

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

# NeuralDEEP PRO — только модели каталога NeuralDEEP, без GPT/OpenAI
LLM_BASE_URL=https://api.neuraldeep.ru/v1
LLM_API_KEY=sk-your-neuraldeep-pro-key
LLM_TIMEOUT_SECONDS=180

# Seed accounts (created on first backend start)
SEED_ADMIN_EMAIL=admin@ncl.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123
SEED_MANAGER_PASSWORD=ChangeMe_Manager_123
SEED_DEVELOPER_EMAIL=dev@ncl.local
SEED_DEVELOPER_PASSWORD=ChangeMe_Dev_123
SEED_BILLING_BALANCE_RUB=5000
